{
  "name": "dsh-mattpocock-preset",
  "version": "1.3.2",
  "private": true,
  "description": "Matt Pocock's agent skills for real engineering",
  "repository": {
    "type": "git",
    "url": "https://github.com/mattpocock/skills"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./dsh/cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.4"
  },
  "scripts": {
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-plugin-version.mjs",
    "check-plugin-version": "node scripts/sync-plugin-version.mjs --check",
    "dsh:install": "node dsh/scripts/install.mjs",
    "dsh:validate": "node dsh/scripts/validate.mjs",
    "dsh:sync": "bash dsh/scripts/sync.sh"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.30.0"
  },
  "packageManager": "npm@10.9.4"
}
