{
  "name": "dsh-coding-preset",
  "version": "2.0.0",
  "private": true,
  "description": "A curated set of coding skill repositories, installed into DeepSeek Harness as a single preset",
  "repository": {
    "type": "git",
    "url": "https://github.com/kimiellen/dsh-MattPocock-preset"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./dsh/cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.4"
  },
  "scripts": {
    "dsh:install": "node dsh/scripts/install.mjs",
    "dsh:validate": "node dsh/scripts/validate.mjs",
    "dsh:sync": "node dsh/scripts/sync.mjs"
  },
  "packageManager": "npm@10.9.4"
}
